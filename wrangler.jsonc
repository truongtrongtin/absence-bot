{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "absence-bot",
  "main": "src/main.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"],
  "upload_source_maps": true,
  "triggers": {
    "crons": ["0 0 * * 2-6"],
  },
  "observability": {
    "enabled": true,
  },
}
